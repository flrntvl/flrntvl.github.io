---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { getEntryPath } from '../../lib/content';
import { fill } from '../../lib/format';
import WarnIcon from '../icons/Warn.astro';

interface Props {
  entry: CollectionEntry<'cheatsheets'>;
  /**
   * Liste des fiches : titre, commande et description sur trois lignes, avec les OS.
   * Sinon (accueil) : titre et commande sur une ligne.
   */
  stacked?: boolean;
}

const { entry, stacked = false } = Astro.props;
const { lang, title, command, description, destructive, category, tags, os } = entry.data;
const t = useTranslations(lang);
const search = [title, command, description, category, ...tags].filter(Boolean).join(' ');
const systems = [
  { on: os.linux, label: 'Linux' },
  { on: os.macos, label: 'macOS' },
  { on: os.windows, label: 'Windows' },
]
  .filter((s) => s.on)
  .map((s) => s.label);
---

<a
  href={getEntryPath('cheatsheets', entry)}
  class:list={['cs-row', { stacked }]}
  data-search={search}
>
  <span class="head">
    <span class="row-title">{title}</span>
    {
      destructive && (
        <span class="warn" title={t('cheatsheet.destructiveTitle')}>
          <WarnIcon />
          {t('cheatsheet.destructive')}
        </span>
      )
    }
    {
      stacked && systems.length > 0 && (
        <span class="systems muted" title={fill(t('cheatsheet.worksOn'), { os: systems.join(', ') })}>
          <span class="sr-only">{fill(t('cheatsheet.worksOn'), { os: '' })}</span>
          {systems.join(' · ')}
        </span>
      )
    }
  </span>
  {command && <code class="row-cmd code">{command}</code>}
  {stacked && <span class="muted desc">{description}</span>}
</a>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }

  .cs-row:not(.stacked) .head {
    flex: 1 1 auto;
  }

  .cs-row:not(.stacked) .row-cmd {
    margin-left: auto;
  }

  .stacked {
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }

  .row-title {
    font-weight: 500;
  }

  .row-cmd {
    color: var(--muted);
    font-size: 13px;
  }

  .stacked .row-cmd {
    color: var(--fg);
  }

  .desc {
    font-size: 14px;
  }

  .systems {
    font-family: var(--code);
    font-size: 12px;
  }

</style>
