---
/*
 * Contrôles Thème (Appareil / Clair / Sombre) et Style (Éditorial / Dev).
 * Utilisés par le menu Apparence (desktop) et le menu plein écran (mobile) ;
 * tous les contrôles de la page restent synchronisés (src/scripts/appearance-controls.ts).
 */
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Préfixe des id (plusieurs instances par page). */
  id: string;
  /** Taille un peu plus grande dans le menu mobile. */
  large?: boolean;
}

const { lang, id, large = false } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={["controls", { large }]} data-appearance-controls>
  <div class="field">
    <span class="lbl" id={`${id}-theme`}>{t("appearance.theme")}</span>
    <div class="ctl" role="group" aria-labelledby={`${id}-theme`}>
      <button type="button" class="seg" data-theme-pref="auto" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="2"></rect>
          <path d="M8 20h8M12 16v4"></path>
        </svg>
        <span class="lc">{t("appearance.theme.auto")}</span>
      </button>
      <button type="button" class="seg" data-theme-pref="light" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <span class="lc">{t("appearance.theme.light")}</span>
      </button>
      <button type="button" class="seg" data-theme-pref="dark" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
        </svg>
        <span class="lc">{t("appearance.theme.dark")}</span>
      </button>
    </div>
  </div>

  <div class="field">
    <span class="lbl" id={`${id}-style`}>{t("appearance.style")}</span>
    <div class="cards" role="group" aria-labelledby={`${id}-style`}>
      <button type="button" class="style-card" data-style-pref="editorial" aria-pressed="false">
        <span class="sample sample-editorial" aria-hidden="true">Aa</span>
        <span class="lc">{t("appearance.style.editorial")}</span>
      </button>
      <button type="button" class="style-card" data-style-pref="mono" aria-pressed="false">
        <span class="sample sample-mono" aria-hidden="true">&gt;_</span>
        <span class="lc">{t("appearance.style.mono")}</span>
      </button>
    </div>
  </div>

  <slot />
</div>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .large {
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lbl {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }

  .ctl {
    display: flex;
    gap: 2px;
    padding: 4px;
    background: var(--surface);
    border-radius: calc(var(--radius) - 2px);
  }

  .seg {
    flex: 1;
    height: 36px;
    min-width: 36px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: calc(var(--radius) - 5px);
    color: var(--muted);
    font-size: 12px;
  }

  .large .seg {
    height: 44px;
    font-size: 13px;
  }

  .seg:hover {
    color: var(--fg);
  }

  .seg[aria-pressed="true"] {
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 0 0 1px var(--line);
  }

  :global(:root[data-style="mono"]) .seg[aria-pressed="true"] {
    color: var(--accent);
  }

  .cards {
    display: flex;
    gap: 8px;
  }

  .style-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 8px 12px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 4px);
    color: var(--muted);
    font-size: 12px;
  }

  .large .style-card {
    padding: 18px 8px 14px;
    font-size: 13px;
  }

  .style-card:hover {
    color: var(--fg);
  }

  .style-card[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--fg);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .sample {
    color: var(--fg);
    line-height: 1;
  }

  .sample-editorial {
    font-family: var(--font-geist);
    font-size: 22px;
    font-weight: 500;
  }

  .sample-mono {
    font-family: var(--font-jetbrains-mono);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
  }
</style>

<script>
  import "../scripts/appearance-controls";
</script>
