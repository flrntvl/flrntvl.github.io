---
/*
 * Palette de recherche (⌘K / Ctrl K / « / ») : résultats Pagefind groupés par type,
 * et mode commandes quand la saisie commence par « > ».
 * Le comportement est dans src/scripts/search.ts.
 */
import { languages, routes, ui, type Lang, type RouteKey } from '../i18n/ui';
import { getRouteKey, useTranslations } from '../i18n/utils';
import SearchIcon from './icons/Search.astro';

interface Props {
  lang: Lang;
  /** Même page dans l'autre langue (commande « lang »). */
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;

// Textes et chemins utiles au script, sérialisés dans un attribut data-.
const strings = Object.fromEntries(
  Object.entries(ui[lang]).filter(([key]) => key.startsWith('search.') || key.startsWith('cmd.')),
);
const paths = Object.fromEntries(
  (Object.keys(routes) as RouteKey[]).map((key) => [key, routes[key][lang]]),
);
const config = {
  lang,
  strings,
  paths,
  current: getRouteKey(Astro.url.pathname) ?? null,
  langPaths: { [lang]: Astro.url.pathname, [otherLang]: alternatePath },
};
---

<dialog class="search" aria-label={t('search.label')} data-search-dialog data-config={JSON.stringify(config)}>
  <div class="panel">
    <div class="field">
      <span class="e-only icon"><SearchIcon /></span>
      <span class="m-only acc caret-in" aria-hidden="true">&gt;</span>
      <input
        type="search"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-label={t('search.open')}
        placeholder={t('search.placeholder')}
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button type="button" class="close" aria-label={t('search.close')} data-search-close>
        <kbd class="close-kbd">esc</kbd>
        <span class="close-text lc">{t('search.cancel')}</span>
      </button>
    </div>

    <div class="toolbar" data-search-toolbar>
      <div class="chips" role="group" aria-label={t('search.filter')}>
        <button type="button" class="chip" data-type="" aria-pressed="true">{t('common.filterAll')}</button>
        <button type="button" class="chip" data-type="article" aria-pressed="false">{t('search.type.article')}</button>
        <button type="button" class="chip" data-type="project" aria-pressed="false">{t('search.type.project')}</button>
        <button type="button" class="chip" data-type="cheatsheet" aria-pressed="false">{t('search.type.cheatsheet')}</button>
      </div>
      <span class="count muted code" aria-live="polite" data-search-count></span>
    </div>

    <div class="results" id="search-results" role="listbox" aria-label={t('search.label')} data-search-results></div>

    <div class="hints muted">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t('search.hint.navigate')}</span>
      <span><kbd>↵</kbd> {t('search.hint.open')}</span>
      <span><kbd>esc</kbd> {t('search.hint.close')}</span>
      <span class="hint-cmd"><kbd>&gt;</kbd> {t('search.hint.commands')}</span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: calc(100% - 48px);
    max-width: 660px;
    max-height: calc(100dvh - 112px);
    margin: 88px auto auto;
    padding: 0;
    overflow: hidden;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 32px 80px -20px rgba(0, 0, 0, 0.5);
  }

  .search[open] {
    display: flex;
  }

  .search::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(3px);
  }

  .panel {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 4px 18px;
    border-bottom: 1px solid var(--line);
  }

  .icon {
    color: var(--muted);
  }

  .caret-in {
    font-size: 16px;
    font-weight: 700;
  }

  .field input {
    flex: 1;
    min-width: 0;
    height: 52px;
    font-size: 17px;
    outline: none;
  }

  .field input::-webkit-search-cancel-button {
    display: none;
  }

  .close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
  }

  .close-text {
    display: none;
    font-size: 15px;
    color: var(--accent);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 16px 4px;
  }

  .count {
    font-size: 12px;
  }

  .results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 4px 8px 8px;
  }

  .hints {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 12px 18px;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 12px;
  }

  .hints span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hint-cmd {
    margin-left: auto;
  }

  /* Écran étroit : recherche plein écran, bouton « Annuler » */
  @media (max-width: 600px) {
    .search {
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border: 0;
      border-radius: 0;
    }

    .close-kbd,
    .hints {
      display: none;
    }

    .close-text {
      display: inline;
    }

    .toolbar .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
  }
</style>

<style is:global>
  /* Résultats (créés par le script) */
  .search .glabel {
    padding: 14px 12px 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }

  :root[data-style='mono'] .search .glabel {
    font-weight: 400;
    text-transform: lowercase;
  }

  :root[data-style='mono'] .search .glabel::after {
    content: '/';
  }

  .search .res {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: calc(var(--radius) - 3px);
    color: var(--fg);
  }

  .search .res[aria-selected='true'] {
    background: var(--surface);
  }

  .search .res-icon {
    flex: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
  }

  .search .res-caret {
    flex: none;
    font-size: 14px;
    color: transparent;
  }

  .search .res-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search .res-title {
    overflow: hidden;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .search .res-title.is-code {
    font-family: var(--code);
    font-size: 14px;
  }

  :root[data-style='mono'] .search .res-title.is-code::before {
    content: '$ ';
    color: var(--accent);
  }

  .search .res-sub {
    overflow: hidden;
    font-family: var(--body);
    font-size: 13px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--muted);
  }

  .search .res-meta {
    flex: none;
    font-size: 12px;
    color: var(--muted);
  }

  .search .res-enter {
    flex: none;
    font-family: var(--code);
    font-size: 13px;
    color: var(--muted);
    opacity: 0;
  }

  .search .res[aria-selected='true'] .res-enter {
    opacity: 1;
  }

  .search .res[aria-selected='true'] .res-icon,
  .search .res[aria-selected='true'] .res-title,
  .search .res[aria-selected='true'] .res-caret {
    color: var(--accent);
  }

  .search .empty-state {
    padding: 48px 16px;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
  }
</style>

<script>
  import '../scripts/search';
</script>
