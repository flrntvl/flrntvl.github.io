---
/* Date : « 14 oct. 2026 » (attribut datetime au format ISO). */
import type { Lang } from '../../i18n/ui';
import { formatDate, isoDate } from '../../lib/format';

interface Props {
  date: Date;
  lang: Lang;
  class?: string;
}

const { date, lang, class: className } = Astro.props;
---

<time datetime={isoDate(date)} class={className}>{formatDate(date, lang)}</time>
