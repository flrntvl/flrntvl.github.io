---
/* En-tête des pages de liste : titre, intro. */
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<div class="head">
  <h1 class="page-title">{title}</h1>
  <slot name="aside" />
</div>
<p class="body muted page-intro">{intro}</p>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }
</style>
