---
import { rssPath, social } from "../../config";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { label: social.github.label, href: social.github.href },
  { label: social.linkedin.label, href: social.linkedin.href },
  { label: social.x.label, href: social.x.href },
  { label: "RSS", href: rssPath[lang] },
];
---

<section class="hero">
  <div class="e-only">
    <p class="code muted kicker">{t("home.kicker")}</p>
    <h1 class="title-e">
      {t("home.title")}{" "}
      <span class="serif">{t("home.title.accent")}</span>
    </h1>
  </div>
  <div class="m-only">
    <p class="muted whoami"><span class="acc">$</span> whoami</p>
    <h1 class="title-m">{t("site.name")}</h1>
    <p class="body lead-m">{t("home.title.mono")}</p>
  </div>
  <p class="body muted intro">{t("home.intro")}</p>
  <div class="links lc">
    {links.map((link) => <a href={link.href}>{link.label} ↗︎</a>)}
  </div>
</section>

<style>
  .hero {
    padding: 104px 0 88px;
  }

  .kicker {
    margin: 0 0 24px;
    font-size: 13px;
  }

  .title-e {
    margin: 0;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .title-e .serif {
    letter-spacing: -0.01em;
  }

  .whoami {
    margin: 0;
    font-size: 14px;
  }

  .title-m {
    margin: 16px 0 0;
    font-size: 64px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .lead-m {
    margin: 24px 0 0;
    font-size: 24px;
    line-height: 1.4;
    font-weight: 500;
  }

  .intro {
    margin: 24px 0 0;
    max-width: 580px;
    font-size: 18px;
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 32px;
    font-size: 14px;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 64px 0 56px;
    }

    .title-e {
      font-size: 40px;
    }

    .title-m {
      font-size: 48px;
    }
  }
</style>
