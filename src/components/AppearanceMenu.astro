---
/*
 * Bouton « Apparence » de l'en-tête (desktop) + menu Thème / Style.
 * Les contrôles eux-mêmes sont dans AppearanceControls.astro.
 */
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import AppearanceControls from "./AppearanceControls.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="appearance" data-appearance>
  <button
    type="button"
    class="hdr-btn trigger"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="appearance-panel"
    data-appearance-trigger
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"></path>
      <circle cx="16" cy="6" r="2"></circle>
      <circle cx="10" cy="12" r="2"></circle>
      <circle cx="18" cy="18" r="2"></circle>
    </svg>
    <span class="lc">{t("appearance.open")}</span>
    <svg
      class="muted"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    id="appearance-panel"
    class="pop"
    role="dialog"
    aria-label={t("appearance.open")}
    hidden
    data-appearance-panel
  >
    <AppearanceControls lang={lang} id="appearance">
      <p class="saved muted">{t("appearance.saved")}</p>
    </AppearanceControls>
  </div>
</div>

<style>
  .appearance {
    position: relative;
  }

  .trigger {
    font-weight: 500;
  }

  .pop {
    position: absolute;
    top: 54px;
    right: 0;
    z-index: 20;
    width: 304px;
    padding: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 56px -18px rgba(0, 0, 0, 0.35);
  }

  .saved {
    margin: 0;
    font-size: 12px;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-appearance]");
  const trigger = root?.querySelector<HTMLButtonElement>("[data-appearance-trigger]");
  const panel = root?.querySelector<HTMLElement>("[data-appearance-panel]");

  if (root && trigger && panel) {
    const open = () => {
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      panel.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
    };

    const close = (restoreFocus = true) => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };

    trigger.addEventListener("click", () => (panel.hidden ? open() : close()));

    // Échap ferme le menu et rend le focus au bouton.
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        event.stopPropagation();
        close();
      }
    });

    // Clic à l'extérieur ou focus qui sort du menu : on ferme sans voler le focus.
    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) close(false);
    });
    root.addEventListener("focusout", (event) => {
      if (event.relatedTarget && !root.contains(event.relatedTarget as Node)) close(false);
    });
  }
</script>
