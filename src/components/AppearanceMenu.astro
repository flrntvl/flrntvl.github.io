---
/*
 * Bouton Thème de l'en-tête (desktop) : icône seule + petit menu Appareil / Clair / Sombre.
 * L'icône montre le thème affiché (soleil en clair, lune en sombre), posée en CSS
 * d'après data-theme : pas de JS, pas de saut au chargement.
 * Les contrôles eux-mêmes sont dans AppearanceControls.astro.
 */
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import AppearanceControls from "./AppearanceControls.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="appearance" data-appearance>
  <button
    type="button"
    class="hdr-btn trigger"
    aria-label={t("appearance.theme")}
    title={t("appearance.theme")}
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="appearance-panel"
    data-appearance-trigger
  >
    <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
    </svg>
  </button>

  <div
    id="appearance-panel"
    class="pop"
    role="dialog"
    aria-label={t("appearance.theme")}
    hidden
    data-appearance-panel
  >
    <AppearanceControls lang={lang} id="appearance" menu>
      <p class="saved muted">{t("appearance.saved")}</p>
    </AppearanceControls>
  </div>
</div>

<style>
  .appearance {
    position: relative;
  }

  .trigger {
    width: 36px;
    padding: 0;
    justify-content: center;
  }

  /* Zone cliquable 44 × 44 autour du bouton de 36 px */
  .trigger::after {
    inset: -5px -4px;
  }

  .trigger[aria-expanded="true"] {
    border-color: var(--muted);
  }

  .moon,
  :global([data-theme="dark"]) .sun {
    display: none;
  }

  :global([data-theme="dark"]) .moon {
    display: block;
  }

  .pop {
    position: absolute;
    top: 44px;
    right: 0;
    z-index: 20;
    width: 196px;
    padding: 5px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 56px -18px rgba(0, 0, 0, 0.35);
  }

  .saved {
    margin: 0;
    padding: 8px 9px 4px;
    border-top: 1px solid var(--line);
    font-size: 12px;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-appearance]");
  const trigger = root?.querySelector<HTMLButtonElement>("[data-appearance-trigger]");
  const panel = root?.querySelector<HTMLElement>("[data-appearance-panel]");

  if (root && trigger && panel) {
    const open = () => {
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      panel.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
    };

    const close = (restoreFocus = true) => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };

    trigger.addEventListener("click", () => (panel.hidden ? open() : close()));

    // Un choix fait ferme le menu (le thème est appliqué par appearance-controls.ts).
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-theme-pref]")) close();
    });

    // Flèches haut / bas : passer d'un choix à l'autre.
    panel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const items = [...panel.querySelectorAll<HTMLButtonElement>("[data-theme-pref]")];
      const index = items.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      event.preventDefault();
      const step = event.key === "ArrowDown" ? 1 : -1;
      items[(index + step + items.length) % items.length].focus();
    });

    // Échap ferme le menu et rend le focus au bouton.
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        event.stopPropagation();
        close();
      }
    });

    // Clic à l'extérieur ou focus qui sort du menu : on ferme sans voler le focus.
    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) close(false);
    });
    root.addEventListener("focusout", (event) => {
      if (event.relatedTarget && !root.contains(event.relatedTarget as Node)) close(false);
    });
  }
</script>
