---
/*
 * Script anti-flash : exécuté dans <head>, avant le premier affichage.
 * Lit les préférences et pose data-theme / data-style (et data-os) sur <html>.
 * Doit rester synchronisé avec src/scripts/appearance.ts (mêmes clés, même résolution).
 */
---

<script is:inline>
  (() => {
    const root = document.documentElement;
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');
    const read = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const apply = () => {
      const theme = read('theme');
      root.dataset.theme =
        theme === 'light' || theme === 'dark' ? theme : darkQuery.matches ? 'dark' : 'light';
      root.dataset.style = read('style') === 'mono' ? 'mono' : 'editorial';
    };
    apply();
    // Raccourci affiché : ⌘K sur Apple, Ctrl K ailleurs (évite un saut du libellé).
    const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
    root.dataset.os = /mac|iphone|ipad|ipod/i.test(platform) ? 'apple' : 'other';
    // Mode « auto » : suivre les changements de l'appareil.
    darkQuery.addEventListener('change', () => {
      const theme = read('theme');
      if (theme !== 'light' && theme !== 'dark') apply();
    });
  })();
</script>
