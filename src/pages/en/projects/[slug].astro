---
import ProjectPage from '../../../views/ProjectPage.astro';
import MissingTranslationPage from '../../../views/MissingTranslationPage.astro';
import { getDetailPaths } from '../../../lib/content';

export async function getStaticPaths() {
  return getDetailPaths('projects', 'en');
}

const { entry, missing } = Astro.props;
---

{entry ? <ProjectPage entry={entry} /> : <MissingTranslationPage collection="projects" entry={missing!} lang="en" />}
