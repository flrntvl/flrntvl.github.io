---
import CheatsheetPage from '../../../views/CheatsheetPage.astro';
import MissingTranslationPage from '../../../views/MissingTranslationPage.astro';
import { getDetailPaths } from '../../../lib/content';

export async function getStaticPaths() {
  return getDetailPaths('cheatsheets', 'en');
}

const { entry, missing } = Astro.props;
---

{entry ? <CheatsheetPage entry={entry} /> : <MissingTranslationPage collection="cheatsheets" entry={missing!} lang="en" />}
