---
import ArticlePage from '../../views/ArticlePage.astro';
import MissingTranslationPage from '../../views/MissingTranslationPage.astro';
import { getDetailPaths } from '../../lib/content';

export async function getStaticPaths() {
  return getDetailPaths('articles', 'fr');
}

const { entry, missing } = Astro.props;
---

{entry ? <ArticlePage entry={entry} /> : <MissingTranslationPage collection="articles" entry={missing!} lang="fr" />}
