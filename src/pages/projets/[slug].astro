---
import { getCollection } from 'astro:content';
import ProjectPage from '../../views/ProjectPage.astro';
import { getSlug, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection(
    'projects',
    (e) => e.data.lang === 'fr' && isPublished(e),
  );
  return entries.map((entry) => ({ params: { slug: getSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ProjectPage entry={entry} />
