---
import '@/styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import Footer from '@/components/base/Footer';
import Header from '@/components/base/Header';
import { AVATAR_URL, LABELS, type Lang } from '@/lib/site-content';

interface Props {
	title?: string;
	description?: string;
	lang: Lang;
	path?: string;
	langHref?: string;
	image?: string;
	noindex?: boolean;
	/** Other-language URL of this page, or null when none exists (see resolvedAlternateHref). */
	alternateHref?: string | null;
	/** Switches og:type from "website" to "article" — see SEO.md §4. */
	publishedTime?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	lang,
	path = '~',
	langHref,
	image = AVATAR_URL,
	noindex = false,
	alternateHref,
	publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const resolvedLangHref = langHref ?? getRelativeLocaleUrl(otherLang);
// getRelativeLocaleUrl appends a trailing slash, which breaks the .xml endpoint.
const feedHref = getRelativeLocaleUrl(lang, 'rss.xml').replace(/\/$/, '');
// Undefined means "use the default"; null means "no translation exists".
const resolvedAlternateHref = alternateHref === undefined ? getRelativeLocaleUrl(otherLang) : alternateHref;
const alternateURL = resolvedAlternateHref ? new URL(resolvedAlternateHref, Astro.site) : null;
const xDefaultURL: URL = lang === 'fr' || !alternateURL ? canonicalURL : alternateURL;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={LABELS[lang].meta.title} href={feedHref} />
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		{!noindex && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
		{!noindex && alternateURL && <link rel="alternate" hreflang={otherLang} href={alternateURL} />}
		{!noindex && alternateURL && <link rel="alternate" hreflang="x-default" href={xDefaultURL} />}
		<meta name="generator" content={Astro.generator} />

		<Font cssVariable="--font-jetbrains-mono" preload />

		<title>{title}</title>
		{!noindex && <meta name="description" content={description} />}

		{
			!noindex && (
				<>
					<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
					{publishedTime && <meta property="article:published_time" content={publishedTime} />}
					<meta property="og:url" content={Astro.url} />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:image" content={image} />
					<meta name="twitter:card" content="summary" />
				</>
			)
		}

		<slot name="head" />

		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			} catch {
				// Storage unavailable: fall back to the light theme.
			}
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header client:load path={path} lang={lang} langHref={resolvedLangHref} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
