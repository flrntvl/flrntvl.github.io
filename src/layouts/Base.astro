---
import '@/styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Font } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import SiteFooter from '@/components/layout/SiteFooter';
import SiteHeader from '@/components/layout/SiteHeader';
import { AVATAR_URL, type Lang } from '@/lib/site-content';

interface Props {
	title?: string;
	description?: string;
	lang: Lang;
	path?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	lang,
	path = '~',
	image = AVATAR_URL,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const langHref = getRelativeLocaleUrl(otherLang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		<meta name="generator" content={Astro.generator} />

		<Font cssVariable="--font-jetbrains-mono" preload />

		<title>{title}</title>
		{!noindex && <meta name="description" content={description} />}

		{
			!noindex && (
				<>
					<meta property="og:type" content="website" />
					<meta property="og:url" content={Astro.url} />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:image" content={image} />
					<meta name="twitter:card" content="summary" />
				</>
			)
		}

		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			} catch {
				// Storage unavailable: fall back to the light theme.
			}
		</script>
	</head>
	<body>
		<SiteHeader client:load path={path} lang={lang} langHref={langHref} />
		<slot />
		<SiteFooter lang={lang} />
	</body>
</html>
