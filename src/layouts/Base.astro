---
import { Font } from 'astro:assets';
import AppearanceScript from '../components/AppearanceScript.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { getAlternatePath, getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Chemin de la page dans l'autre langue (sinon correspondance automatique). */
  alternatePath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('site.description'), alternatePath } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.name')}` : t('site.name');
const otherPath = alternatePath ?? getAlternatePath(Astro.url.pathname, lang === 'fr' ? 'en' : 'fr');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <AppearanceScript />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Style éditorial (par défaut) : préchargé -->
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-geist-mono" />
    <!-- Style dev : téléchargé seulement si le style est actif -->
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-ibm-plex-sans" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t('a11y.skip')}</a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} alternatePath={otherPath} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    outline: none;
  }
</style>
