---
import { Font } from 'astro:assets';
import AppearanceScript from '../components/AppearanceScript.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ShortcutsDialog from '../components/ShortcutsDialog.astro';
import { rssPath } from '../config';
import { defaultLang } from '../i18n/ui';
import { getAlternatePath, getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Chemin de la page dans l'autre langue (sinon correspondance automatique). */
  alternatePath?: string;
  /** false : l'autre langue n'est pas une vraie traduction (pas de hreflang). */
  translated?: boolean;
  /** Page à ne pas indexer (404, « non traduit »). */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === 'fr' ? 'en' : 'fr';
const t = useTranslations(lang);
const { title, description = t('site.description'), alternatePath, translated = true, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.name')}` : t('site.name');
const otherPath = alternatePath ?? getAlternatePath(Astro.url.pathname, otherLang);
const isHome = ['/', '/en/'].includes(Astro.url.pathname);

// URL absolues pour canonical / hreflang (site défini dans astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = translated
  ? { [lang]: canonical, [otherLang]: new URL(otherPath, Astro.site).href }
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <AppearanceScript />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && alternates && (
        <>
          <link rel="alternate" hreflang="fr" href={alternates.fr} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates[defaultLang]} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={rssPath[lang]} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Style éditorial (par défaut) : seules les graisses du texte et des titres sont préchargées ;
         Instrument Serif ne sert qu'au titre de l'accueil. -->
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }, { weight: 500 }]} />
    <Font cssVariable="--font-instrument-serif" preload={isHome} />
    <Font cssVariable="--font-geist-mono" />
    <!-- Style dev : téléchargé seulement si le style est actif -->
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-ibm-plex-sans" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t('a11y.skip')}</a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} alternatePath={otherPath} />
    <ShortcutsDialog lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    outline: none;
  }
</style>
