---
import type { MarkdownHeading } from 'astro';
import Base from '@/layouts/Base.astro';
import { formatCommitDateTime } from '@/lib/articles';
import { LABELS, type Lang } from '@/lib/site-content';

interface Props {
	langHref: string;
	slug: string;
	title: string;
	standfirst: string;
	published: string;
	modified: string | null;
	readingTime: string;
	headings: MarkdownHeading[];
}

const { langHref, slug, title, standfirst, published, modified, readingTime, headings } = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = LABELS[lang];
const publishedLabel = t.publishedLabel(formatCommitDateTime(published, lang) ?? '');
const modifiedLabel = modified ? t.modifiedLabel(formatCommitDateTime(modified, lang) ?? '') : null;
const readingTimeLabel = t.readingTimeLabel(readingTime);
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base
	lang={lang}
	path="~/blog/"
	langHref={langHref}
	title={`${title} — flrntvl.dev`}
	description={standfirst}
>
	<div class="mx-auto max-w-[1400px] px-8 pt-16 pb-24 sm:px-10">
		<div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_760px_1fr]">
			<article class="min-w-0 lg:col-start-2">
				{
					toc.length > 0 && (
						<details class="mb-8 text-[13px] lg:hidden">
							<summary class="cursor-pointer text-foreground select-none">{t.tableOfContents}/</summary>
							<nav class="mt-2 flex flex-col gap-2">
								{toc.map((heading, i) => (
									<a href={`#${heading.slug}`}>
										{i === toc.length - 1 ? '└─' : '├─'} {heading.text}
									</a>
								))}
							</nav>
						</details>
					)
				}

				<p class="text-[15px]">
					<span class="text-primary">~/blog/</span>
					<span class="text-muted-foreground">$</span>
					<span class="text-foreground">cat {slug}.md</span>
				</p>

				<h1 class="mt-6 text-[38px] leading-[1.15] font-medium tracking-[-0.03em]">{title}</h1>

				<time class="mt-4 block text-xs text-muted-foreground" datetime={published}>{publishedLabel}</time>
				{modifiedLabel && <p class="mt-1 text-xs text-muted-foreground">{modifiedLabel}</p>}
				<p class="mt-1 text-xs text-muted-foreground">{readingTimeLabel}</p>

				<p class="mt-6 text-base leading-[1.7] text-muted-foreground">{standfirst}</p>

				<div class="prose mt-10">
					<slot />
				</div>
			</article>

			{
				toc.length > 0 && (
					<aside class="hidden lg:col-start-3 lg:block">
						<nav class="sticky top-8 flex flex-col gap-2 text-[13px]">
							<span class="text-foreground">{t.tableOfContents}/</span>
							{toc.map((heading, i) => (
								<a href={`#${heading.slug}`}>
									{i === toc.length - 1 ? '└─' : '├─'} {heading.text}
								</a>
							))}
						</nav>
					</aside>
				)
			}
		</div>
	</div>
</Base>

<style>
	/* Slotted markdown output lives outside this component's own template, so
	   scoped styles need :global() to reach it — see Astro's styling guide. */
	.prose :global(p) {
		margin-top: 1.5em;
		font-size: 15px;
		line-height: 1.8;
	}
	.prose :global(p:first-child) {
		margin-top: 0;
	}
	.prose :global(h2) {
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		font-size: 15px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}
	/* The `##` stays visible on purpose — see DESIGN.md §3. */
	.prose :global(h2::before) {
		content: '## ';
	}
	.prose :global(a) {
		color: var(--primary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.prose :global(code) {
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--card);
		padding: 0.1em 0.4em;
		font-size: 0.9em;
	}
	.prose :global(pre) {
		margin-top: 1.5em;
		overflow-x: auto;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: var(--card);
		padding: 16px;
		font-size: 13px;
		line-height: 1.65;
	}
	.prose :global(pre code) {
		border: none;
		background: none;
		padding: 0;
		font-size: inherit;
	}
</style>
