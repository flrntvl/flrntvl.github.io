---
import type { MarkdownHeading } from 'astro';
import Base from '@/layouts/Base.astro';
import { formatCommitDateTime } from '@/lib/articles';
import { GITHUB_URL, LABELS, type Lang } from '@/lib/site-content';

interface Props {
	langHref: string;
	alternateHref: string | null;
	slug: string;
	title: string;
	standfirst: string;
	published: string;
	modified: string | null;
	readingTime: string;
	headings: MarkdownHeading[];
}

// prettier-ignore
const {
	langHref,
	alternateHref,
	slug,
	title,
	standfirst,
	published,
	modified,
	readingTime,
	headings,
} = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = LABELS[lang];
const publishedLabel = t.publishedLabel(formatCommitDateTime(published, lang) ?? '');
const modifiedLabel = modified ? t.modifiedLabel(formatCommitDateTime(modified, lang) ?? '') : null;
const readingTimeLabel = t.readingTimeLabel(readingTime);
const toc = headings.filter((heading) => heading.depth === 2);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: standfirst,
	datePublished: published,
	dateModified: modified ?? published,
	author: { '@type': 'Person', name: 'Florent Val', url: GITHUB_URL },
	inLanguage: lang,
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base
	lang={lang}
	path="~/blog/"
	langHref={langHref}
	alternateHref={alternateHref}
	publishedTime={published}
	title={`${title} — flrntvl.dev`}
	description={standfirst}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<div class="mx-auto max-w-[1400px] px-8 pt-16 pb-24 sm:px-10">
		<div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_760px_1fr]">
			<article class="min-w-0 lg:col-start-2">
				{
					toc.length > 0 && (
						<details class="mb-8 text-[13px] lg:hidden">
							<summary class="cursor-pointer text-foreground select-none">{t.tableOfContents}/</summary>
							<nav class="mt-2 flex flex-col gap-2">
								{toc.map((heading, i) => (
									<a href={`#${heading.slug}`}>
										{i === toc.length - 1 ? '└─' : '├─'} {heading.text}
									</a>
								))}
							</nav>
						</details>
					)
				}

				<p class="text-[15px]">
					<span class="text-primary">~/blog/</span>
					<span class="text-muted-foreground">$</span>
					<span class="text-foreground">cat {slug}.md</span>
				</p>

				<h1 class="mt-6 text-[38px] leading-[1.15] font-medium tracking-[-0.03em]">{title}</h1>

				<time class="mt-4 block text-xs text-muted-foreground" datetime={published}>{publishedLabel}</time>
				{modifiedLabel && <p class="mt-1 text-xs text-muted-foreground">{modifiedLabel}</p>}
				<p class="mt-1 text-xs text-muted-foreground">{readingTimeLabel}</p>

				<p class="mt-6 text-base leading-[1.7] text-muted-foreground">{standfirst}</p>

				<div class="prose mt-10">
					<slot />
				</div>
			</article>

			{
				toc.length > 0 && (
					<aside class="hidden lg:col-start-3 lg:block">
						<nav class="sticky top-8 flex flex-col gap-2 text-[13px]">
							<span class="text-foreground">{t.tableOfContents}/</span>
							{toc.map((heading, i) => (
								<a href={`#${heading.slug}`}>
									{i === toc.length - 1 ? '└─' : '├─'} {heading.text}
								</a>
							))}
						</nav>
					</aside>
				)
			}
		</div>
	</div>
</Base>
