{
  "name": "flrntvl.github.io",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "search:dev": "SHOW_DRAFTS=true astro build && pagefind --site dist --output-path public/pagefind",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "astro": "^7.4.12",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0"
  }
}
